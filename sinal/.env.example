# SINAL, variaveis de ambiente
# Copia este ficheiro para .env.local e preenche. Nunca versionar .env.local.
# Nenhuma destas chaves pode ir para o cliente, excepto as marcadas NEXT_PUBLIC.

# URL publico da aplicacao (ex: https://sinal.vercel.app, ou http://localhost:3000 em dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase, projecto Postgres + Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servico, so no servidor, contorna RLS. Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth, cliente Web da Google Cloud Console
# Consentimento com scope calendar.events, access_type=offline, prompt=consent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VAPID para push (gera com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:casa@exemplo.pt

# Cron da Vercel, segredo para proteger /api/cron/lembretes
CRON_SECRET=
